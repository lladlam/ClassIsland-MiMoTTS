<ci:SpeechProviderControlBase x:Class="MiMoTTS.CI1.Controls.SpeechProviderSettingsControls.MiMoSpeechServiceSettingsControl"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                             xmlns:local="clr-namespace:MiMoTTS.CI1.Controls.SpeechProviderSettingsControls"
                             xmlns:ci="http://classisland.tech/schemas/xaml/core"
                             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
                             mc:Ignorable="d"
                             d:DesignHeight="450" d:DesignWidth="800">
    <ci:SpeechProviderControlBase.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InverseBooleanToVisibilityConverter x:Key="BoolToInverseVisibility"/>
    </ci:SpeechProviderControlBase.Resources>
    <StackPanel DataContext="{Binding}">
        <md:Card Padding="16" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="API 地址" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock Text="按量付费用官方地址；Token Plan 按地区选择 cn / sgp / ams。"
                           FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                <ComboBox Width="280"
                          ItemsSource="{Binding ApiBaseUrlOptions}"
                          SelectedItem="{Binding Settings.ApiBaseUrl, Mode=TwoWay}"/>
            </StackPanel>
        </md:Card>

        <md:Card Padding="16" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="API Key" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <PasswordBox Width="280"
                             PasswordChanged="PasswordChangedHandler"/>
            </StackPanel>
        </md:Card>

        <md:Card Padding="16" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="模型" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock Text="目前支持 mimo-v2-tts、mimo-v2.5-tts 与 mimo-v2.5-tts-voiceclone"
                           FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                <ComboBox Width="220"
                          ItemsSource="{Binding ModelOptions}"
                          SelectedItem="{Binding Settings.Model, Mode=TwoWay}"
                          SelectionChanged="ModelSelectionChanged"/>
            </StackPanel>
        </md:Card>

        <md:Card Padding="16" Margin="0,0,0,8" Visibility="{Binding IsVoiceCloneModel, Converter={StaticResource BoolToInverseVisibility}}">
            <StackPanel>
                <TextBlock Text="音色" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock Text="例如：mimo_default / default_zh / default_en"
                           FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                <TextBox Width="180" Text="{Binding Settings.Voice, Mode=TwoWay}"/>
            </StackPanel>
        </md:Card>

        <md:Card Padding="16" Margin="0,0,0,8" Visibility="{Binding IsVoiceCloneModel, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="音色克隆音频样本" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock Text="选择 mp3 或 wav 格式的音频文件（Base64 不超过 10MB）"
                           FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="240"
                             IsReadOnly="True"
                             Text="{Binding Settings.VoiceCloneAudioPath, Mode=TwoWay}"/>
                    <Button Content="浏览..."
                            Margin="4,0,0,0"
                            Click="BrowseAudioFile_Click"/>
                </StackPanel>
            </StackPanel>
        </md:Card>

        <md:Card Padding="16" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="音频格式" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Width="120" Text="{Binding Settings.AudioFormat, Mode=TwoWay}"/>
            </StackPanel>
        </md:Card>

        <md:Card Padding="16" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="风格标签" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock Text="v2 使用 &lt;style&gt; 标签，v2.5 使用括号风格标签。"
                           FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                <TextBox Width="220" Text="{Binding Settings.Style, Mode=TwoWay}"/>
            </StackPanel>
        </md:Card>

        <md:Card Padding="16" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="语速" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock Text="会和风格标签一起参与文本前缀生成。"
                           FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                <ComboBox Width="150"
                          ItemsSource="{Binding SpeedStyleOptions}"
                          SelectedItem="{Binding Settings.SpeedStyle, Mode=TwoWay}"/>
            </StackPanel>
        </md:Card>

        <md:Card Padding="16" Margin="0,0,0,8" Visibility="{Binding IsVoiceCloneModel, Converter={StaticResource BoolToInverseVisibility}}">
            <StackPanel>
                <TextBlock Text="唱歌模式" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock Text="会在文本最前面自动添加唱歌风格标签。（音色克隆模式不支持）"
                           FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                <CheckBox IsChecked="{Binding Settings.EnableSingingMode, Mode=TwoWay}"/>
            </StackPanel>
        </md:Card>

        <md:Card Padding="16" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="启用自然语言控制" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock Text="会把提示词作为 user 角色消息发送，可选但建议携带。"
                           FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                <CheckBox IsChecked="{Binding Settings.EnableUserPrompt, Mode=TwoWay}"/>
            </StackPanel>
        </md:Card>

        <md:Card Padding="16" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="自然语言控制提示词" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock Text="用于控制语气、情绪、节奏等；不会直接出现在合成语音中。"
                           FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                <TextBox Width="360"
                         Height="72"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Text="{Binding Settings.UserPrompt, Mode=TwoWay}"/>
            </StackPanel>
        </md:Card>
    </StackPanel>
</ci:SpeechProviderControlBase>
